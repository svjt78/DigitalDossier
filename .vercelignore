# ===========================================
# Vercel Ignore File
# ===========================================
# Files and directories to exclude from Vercel deployment

# Local development environment file
.env

# Production environment file (use Vercel dashboard instead)
.env.production

# Backup and copy files
.env copy
.env copy 2
*.env.local
*.env.*.local

# Development Docker files
docker-compose.yml
docker-compose.*.yml
Dockerfile.dev

# Local development data
postgres_data/
pgdata/

# Development scripts that reference local infrastructure
scripts/local-*

# IDE and OS files
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Cache directories
.cache/
node_modules/.cache/

# Temporary files
*.tmp
*.temp
