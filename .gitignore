# ===========================================
# COMPREHENSIVE Security-First .gitignore for Blog App
# ===========================================

# === CRITICAL SECURITY FILES ===
# Environment files with production secrets
.env
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.*.local
*.env
*.env.*

# Environment backup files (CRITICAL - contain production secrets)
.env.*bak*
.env.*backup*
.env.production.bak
.env.production.backup

# === DATABASE SECURITY ===
# Database dumps and backups (may contain sensitive user data)
*.sql
*.dump
backup.sql
database_backups/
db_backups/
backups/
dumps/
*.db.backup
*.sql.backup
*.dump.backup

# Prisma database files
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/
prisma/*.db*

# Local database data
postgres_data/
pgdata/
pg_data/
mysql_data/
mongodb_data/

# === AI/CLAUDE CONVERSATION DATA ===
.claude/
.anthropic/
claude-conversations/
*.claude.json
CLAUDE.md

# === TECHNICAL DOCUMENTATION (Internal) ===
BLOG_APP_MODULE_CONFLICT_RESOLUTION.md

# === NODE.JS ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# === NEXT.JS BUILD OUTPUT ===
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# === DEPENDENCIES ===
jspm_packages/

# === LOGS ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === COPY AND BACKUP FILES (SECURITY CRITICAL) ===
*copy*
*backup*
* copy*
* backup*
*_copy*
*_backup*
*.bak
*.backup
*.orig
*.old
*.save
*.tmp
*.temp

# Specific copy file patterns
.env copy
.env copy 2
.env.production copy
main copy.py
database copy.py
models copy.py
schemas copy.py
requirements copy.txt
docker-compose copy.yml
docker-compose copy 2.yml
*.js.backup
*.py.backup
*.yml.backup
*.json.backup
*.ts.backup

# === DOCKER FILES (Development) ===
docker-compose.override.yml
docker-compose.dev.yml
Dockerfile.dev.local
Dockerfile copy.dev

# === CACHE DIRECTORIES ===
.cache/
.next/cache/
.nuxt/
.output/
.vite/
dist-ssr/
*.local

# === IDE AND EDITOR FILES ===
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
.vscode-test/

# === OS FILES ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
Icon\r

# === DEPLOYMENT PLATFORMS ===
.vercel/
.vercel
.netlify/
.railway/

# === TESTING ===
coverage/
*.lcov
.nyc_output/
.jest/

# === RUNTIME DATA ===
pids/
*.pid
*.seed
*.pid.lock

# === UPLOAD DIRECTORIES (may contain user data) ===
public/uploads/
uploads/
temp-uploads/
user-uploads/
media-uploads/

# === SECURITY SENSITIVE FILES ===
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.jks
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/
.gnupg/

# === TEMPORARY FILES ===
*.tmp
*.temp
.tmp/
.temp/
tmp/
temp/

# === PACKAGE MANAGER ===
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.js

# === LINTING ===
.eslintcache
.stylelintcache

# === MISC CACHE ===
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# === ARCHIVES ===
*.tgz
*.tar.gz
*.zip
*.rar
*.7z

# === SCRIPTS THAT MAY CONTAIN SECRETS ===
setup-production-env.sh
deploy-secrets.sh
*-secrets.*
*-keys.*

# === AUTO-GENERATED DOCUMENTATION ===
.docusaurus/
docs/.vuepress/dist/

# === MONITORING AND PROFILING ===
.clinic/
profile/
*.cpuprofile
*.heapprofile
*.heapsnapshot

# === MISCELLANEOUS ===
.history/
.ionide/
