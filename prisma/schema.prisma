generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model blog {
  id            Int        @id @default(autoincrement())
  title         String
  slug          String     @unique
  author        String
  genre_id      Int?
  summary       String?
  content       String
  cover_key     String?
  pdf_key       String?
  created_at    DateTime   @default(now())
  updated_at    DateTime
  comment_count Int        @default(0)
  net_score     Int        @default(0)
  total_votes   Int        @default(0)
  html_key      String?    @db.VarChar
  genre         genre?     @relation(fields: [genre_id], references: [id])
  blog_tag      blog_tag[]
}

model blog_tag {
  blogId Int
  tagId  Int
  blog   blog @relation(fields: [blogId], references: [id])
  tag    tag  @relation(fields: [tagId], references: [id])

  @@id([blogId, tagId])
}

model book {
  id            Int        @id @default(autoincrement())
  title         String
  slug          String     @unique
  author        String
  genre_id      Int?
  summary       String
  content       String
  cover_key     String?
  pdf_key       String?
  created_at    DateTime   @default(now())
  updated_at    DateTime
  comment_count Int        @default(0)
  net_score     Int        @default(0)
  total_votes   Int        @default(0)
  html_key      String?    @db.VarChar
  genre         genre?     @relation(fields: [genre_id], references: [id])
  book_tag      book_tag[]
}

model book_tag {
  bookId Int
  tagId  Int
  book   book @relation(fields: [bookId], references: [id])
  tag    tag  @relation(fields: [tagId], references: [id])

  @@id([bookId, tagId])
}

model comment {
  id            Int       @id @default(autoincrement())
  content       String
  author_id     Int
  content_type  String
  content_id    Int
  parent_id     Int?
  is_edited     Boolean   @default(false)
  is_deleted    Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime
  user          user      @relation(fields: [author_id], references: [id], onDelete: Cascade)
  comment       comment?  @relation("commentTocomment", fields: [parent_id], references: [id], onDelete: Cascade)
  other_comment comment[] @relation("commentTocomment")

  @@index([author_id])
  @@index([content_type, content_id])
  @@index([content_type, content_id, is_deleted])
  @@index([parent_id])
}

model genre {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  blog    blog[]
  book    book[]
  product product[]
}

model product {
  id            Int           @id @default(autoincrement())
  title         String
  slug          String        @unique
  author        String
  genre_id      Int?
  summary       String
  content       String
  cover_key     String?
  pdf_key       String?
  created_at    DateTime      @default(now())
  updated_at    DateTime
  comment_count Int           @default(0)
  net_score     Int           @default(0)
  total_votes   Int           @default(0)
  html_key      String?       @db.VarChar
  genre         genre?        @relation(fields: [genre_id], references: [id])
  product_tag   product_tag[]
}

model product_tag {
  productId Int
  tagId     Int
  product   product @relation(fields: [productId], references: [id])
  tag       tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
}

model profile {
  id         Int      @id @default(autoincrement())
  avatar_key String?
  created_at DateTime @default(now())
  updated_at DateTime
}

model subscriber {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  created_at DateTime @default(now())
}

model tag {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  blog_tag    blog_tag[]
  book_tag    book_tag[]
  product_tag product_tag[]
}

model user {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  name               String?
  created_at         DateTime  @default(now())
  updated_at         DateTime
  credential_user_id String?
  comment            comment[]
  vote               vote[]
}

model vote {
  id           Int      @id @default(autoincrement())
  user_id      Int
  content_type String
  content_id   Int
  vote_type    String
  created_at   DateTime @default(now())
  updated_at   DateTime
  user         user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, content_type, content_id])
  @@index([content_type, content_id])
  @@index([content_type, content_id, vote_type])
  @@index([user_id])
}
