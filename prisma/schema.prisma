generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Genre {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  description     String?
  isAutoGenerated Boolean   @default(false) @map("is_auto_generated")
  confidence      Float?
  domain          String?
  createdBy       String?   @map("created_by")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  blogs           Blog[]    @relation("BlogGenre")
  books           Book[]    @relation("BookGenre")
  products        Product[] @relation("ProductGenre")

  @@map("genre")
}

model Blog {
  id           Int       @id @default(autoincrement())
  title        String
  slug         String    @unique
  author       String
  genreId      Int?      @map("genre_id")
  genre        Genre?    @relation("BlogGenre", fields: [genreId], references: [id])
  summary      String?
  content      String
  coverKey     String?   @map("cover_key")
  pdfKey       String?   @map("pdf_key")
  tags         BlogTag[]
  webView      WebView?
  
  // New voting and comment aggregation fields
  netScore     Int       @default(0) @map("net_score")
  totalVotes   Int       @default(0) @map("total_votes")
  commentCount Int       @default(0) @map("comment_count")
  
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("blog")
}

model Book {
  id           Int       @id @default(autoincrement())
  title        String
  slug         String    @unique
  author       String
  genreId      Int?      @map("genre_id")
  genre        Genre?    @relation("BookGenre", fields: [genreId], references: [id])
  summary      String
  content      String
  coverKey     String?   @map("cover_key")
  pdfKey       String?   @map("pdf_key")
  tags         BookTag[]
  webView      WebView?
  
  // New voting and comment aggregation fields
  netScore     Int       @default(0) @map("net_score")
  totalVotes   Int       @default(0) @map("total_votes")
  commentCount Int       @default(0) @map("comment_count")
  
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("book")
}

model Product {
  id           Int          @id @default(autoincrement())
  title        String
  slug         String       @unique
  author       String
  genreId      Int?         @map("genre_id")
  genre        Genre?       @relation("ProductGenre", fields: [genreId], references: [id])
  summary      String
  content      String
  coverKey     String?      @map("cover_key")
  pdfKey       String?      @map("pdf_key")
  tags         ProductTag[]
  webView      WebView?
  
  // New voting and comment aggregation fields
  netScore     Int          @default(0) @map("net_score")
  totalVotes   Int          @default(0) @map("total_votes")
  commentCount Int          @default(0) @map("comment_count")
  
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("product")
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  blogs     BlogTag[]
  books     BookTag[]
  products  ProductTag[]

  @@map("tag")
}

model BlogTag {
  blogId  Int
  tagId   Int
  blog    Blog @relation(fields: [blogId], references: [id])
  tag     Tag  @relation(fields: [tagId], references: [id])

  @@id([blogId, tagId])
  @@map("blog_tag")
}

model BookTag {
  bookId  Int
  tagId   Int
  book    Book @relation(fields: [bookId], references: [id])
  tag     Tag  @relation(fields: [tagId], references: [id])

  @@id([bookId, tagId])
  @@map("book_tag")
}

model ProductTag {
  productId  Int
  tagId      Int
  product    Product @relation(fields: [productId], references: [id])
  tag        Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@map("product_tag")
}

model Profile {
  id         Int      @id @default(autoincrement())
  avatarKey  String?  @map("avatar_key")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscriber")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  name              String?   // usernames can repeat and may be null
  credentialUserId  String?   @map("credential_user_id") // optional, for observability
  
  // New relationships
  comments          Comment[]
  votes             Vote[]
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("user")
}

// New Comment model with threading support
model Comment {
  id          Int       @id @default(autoincrement())
  content     String
  authorId    Int       @map("author_id")
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // Polymorphic content reference
  contentType String    @map("content_type") // 'blog', 'book', 'product'
  contentId   Int       @map("content_id")
  
  // Threading support - unlimited depth
  parentId    Int?      @map("parent_id")
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")
  
  // Metadata
  isEdited    Boolean   @default(false) @map("is_edited")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([contentType, contentId])
  @@index([contentType, contentId, isDeleted]) // Performance index for counting
  @@index([parentId])
  @@index([authorId])
  @@map("comment")
}

// New Vote model for thumbs up/down
model Vote {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Polymorphic content reference
  contentType String    @map("content_type") // 'blog', 'book', 'product'
  contentId   Int       @map("content_id")
  
  voteType    String    @map("vote_type") // 'up' or 'down'
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, contentType, contentId]) // One vote per user per content
  @@index([contentType, contentId])
  @@index([contentType, contentId, voteType]) // Performance index for aggregations
  @@index([userId])
  @@map("vote")
}

model WebView {
  id        Int      @id @default(autoincrement())
  blogId    Int?     @map("blog_id")
  bookId    Int?     @map("book_id")
  productId Int?     @map("product_id")
  objectUrl String   @map("object_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Foreign key relationships
  blog      Blog?    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Ensure exactly one content type is associated
  @@unique([blogId])
  @@unique([bookId])
  @@unique([productId])
  @@map("web_view")
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  token       String    @unique
  permissions String[]
  isActive    Boolean   @default(true)
  lastUsed    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("api_token")
}
