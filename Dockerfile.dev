# ========== DEVELOPMENT IMAGE ==========
FROM node:18-alpine

# 1) System deps
RUN apk update && apk add --no-cache \
    postgresql-client \
    libc6-compat    # helps with sharp/libstdc++ issues on Alpine

# 2) Workdir
WORKDIR /app

# 3) Install deps with cache-friendly layering
COPY package.json package-lock.json ./
RUN npm ci

# 4) Prisma schema (generate is optional here; see note below)
COPY prisma ./prisma
# RUN npx prisma generate  # ← redundant; compose runs this at container start

# 5) App source
COPY . .

# 6) Dev env & port
ARG PORT=3003
ENV PORT=${PORT}
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
# Optional (Docker Desktop): reliable file watching
# ENV CHOKIDAR_USEPOLLING=1
# ENV WATCHPACK_POLLING=true

# 7) Expose (nice-to-have)
EXPOSE 3003

# 8) Start Next.js in dev mode (hot-reload)
CMD ["npm", "run", "dev"]
